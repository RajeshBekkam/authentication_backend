{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDb": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "Session": {
      "IdleTimeoutMinutes": 30,
      "AbsoluteLifetimeHours": 12,
      "MaxConcurrentSessions": 5,
      "TouchIntervalSeconds": 60,
      "RetentionDays": 30,
      "CookieName": "__Host-sid"
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "PasswordHashing": {
      "MemorySizeKiB": 19456,
      "Iterations": 2,
      "Parallelism": 1
    },
    "RateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "BootstrapAdmin": {
      "Email": "",
      "Password": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
